# Pooled connection used by the Next.js server (Neon pooler hostname in production).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/returndesk

# Direct connection used by migrations and the seed script. On Neon this must not use the pooler host.
# Locally it can match DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@localhost:5432/returndesk

# Optional. Integration tests default to the same host as DATABASE_URL and the database name returndesk_test.
# DATABASE_URL_TEST=postgres://USER:PASSWORD@localhost:5432/returndesk_test
