          "value": "\"return_requests\".\"customer_email\" = lower(btrim(\"return_requests\".\"customer_email\")) and \"return_requests\".\"customer_email\" ~ '^[^[:space:]@]+@[^[:space:]@]+\\.[^[:space:]@]+$'"
